# ==============================================================================
# GRAMINCARE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Cloud Project Configuration (Client & Server)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Alternatively, legacy anon key naming is also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Server-Side Privileged Key (REQUIRED for backend audits & bypassing RLS)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
# CRITICAL SECURITY RULE: Do NOT prefix with NEXT_PUBLIC_. Keep strictly server-side.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Environment Setting
NEXT_PUBLIC_APP_ENV=production
